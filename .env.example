# Copy to .env.local and fill in. On Vercel, set the same names for
# Production and Preview, then redeploy.

# Supabase > Project Settings > API. The same project and anon key as the
# main site.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API > service_role. Secret: server only,
# never in a NEXT_PUBLIC_ variable. Used by the Team page and the seed and
# create-admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# The public site, where saves send their "content changed" ping, and the
# base for previews and "View on site" links.
MAIN_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identical to REVALIDATE_SECRET in the main site's environment.
REVALIDATE_SECRET=

# Optional, local only: also ping a locally running main site.
# LOCAL_SITE_URL=http://localhost:3000

# Identical to PREVIEW_SECRET in the main site's environment. Signs the
# short-lived tokens that let the live editor show the site's preview page.
# Generate one with: openssl rand -hex 32
PREVIEW_SECRET=

# The Volley app's Supabase project, where the website's "Apply now"
# sign-ups are kept: the Applications page reads them (read only). Its
# address and service role key: Supabase > the Volley app's project >
# Project Settings > API. Server only; never give the key a NEXT_PUBLIC_ name.
VOLLEY_APP_SUPABASE_URL=
VOLLEY_APP_SUPABASE_SERVICE_ROLE_KEY=

# For Accept / Decline on the Applications page, the same as the Volley
# app's admin uses: Mailgun for the emails (MAILGUN_BASE_URL only for an EU
# account), and the resident web app's address for the set-password link.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=
MAILGUN_FROM_EMAIL=
MAILGUN_REPLY_TO=
RESIDENT_PORTAL_URL=

# Who gets a note (the applicant's details) whenever someone on the
# Applications page is invited to an interview or accepted: Elaine.
WAITLIST_NOTIFY_EMAIL=

# Leave empty while the Volley app isn't live: Accept then emails a place
# and hands them to Elaine. Set to "on" once it is: Accept then picks a
# unit and makes their account, with a set-password link.
VOLLEY_APP_ACCOUNTS=
