# Copy to .env.local and fill in. On Vercel, set the same names for
# Production and Preview, then redeploy.

# Supabase > Project Settings > API. The same project and anon key as the
# main site.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API > service_role. Secret: server only,
# never in a NEXT_PUBLIC_ variable. Used by the Team page and the seed and
# create-admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# The public site, where saves send their "content changed" ping, and the
# base for previews and "View on site" links.
MAIN_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identical to REVALIDATE_SECRET in the main site's environment.
REVALIDATE_SECRET=

# Optional, local only: also ping a locally running main site.
# LOCAL_SITE_URL=http://localhost:3000
